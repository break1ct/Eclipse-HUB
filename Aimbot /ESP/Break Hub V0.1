        Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, lockedPlayer.Character.HumanoidRootPart.Position)
    end
    if _G.Hitbox then
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LP and GetPlayerInfo(p) and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                p.Character.HumanoidRootPart.Size = Vector3.new(_G.HitboxSize, _G.HitboxSize, _G.HitboxSize)
                p.Character.HumanoidRootPart.Transparency = 0.7; p.Character.HumanoidRootPart.CanCollide = false
            end
        end
    end
end)

