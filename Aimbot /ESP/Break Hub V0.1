-- // ESP LOGIC //
local function CreateESP(p)
    local Box = Drawing.new("Square"); Box.Thickness = 1.5; Box.Visible = false; Box.Filled = false
    local Name = Drawing.new("Text"); Name.Size = 14; Name.Center = true; Name.Outline = true; Name.Visible = false; Name.Color = Color3.new(1,1,1)
    local Dist = Drawing.new("Text"); Dist.Size = 14; Dist.Center = true; Dist.Outline = true; Dist.Visible = false; Dist.Color = Color3.new(1,1,1)
    local HBg = Drawing.new("Square"); HBg.Thickness = 0; HBg.Filled = true; HBg.Color = Color3.fromRGB(25,25,25); HBg.Transparency = 0.8; HBg.Visible = false
    local HFg = Drawing.new("Square"); HFg.Thickness = 0; HFg.Filled = true; HFg.Transparency = 0.9; HFg.Visible = false

    RunService.RenderStepped:Connect(function()
        local isEnemy, espColor = GetPlayerInfo(p)
        if p ~= LP and isEnemy and p.Character and p.Character:FindFirstChild("HumanoidRootPart") and p.Character:FindFirstChild("Humanoid") and p.Character.Humanoid.Health > 0 then
            local root = p.Character.HumanoidRootPart
            local hum = p.Character.Humanoid
            local pos, onscreen = Camera:WorldToViewportPoint(root.Position)
            if onscreen then
                local size = 2800 / pos.Z; local height = size * 1.3; local x, y = pos.X - size/2, pos.Y - height/2
                Box.Visible = _G.EspBox; if _G.EspBox then Box.Size = Vector2.new(size, height); Box.Position = Vector2.new(x, y); Box.Color = espColor end
                Name.Visible = _G.EspName; if _G.EspName then Name.Text = p.Name; Name.Position = Vector2.new(pos.X, y - 16) end
                Dist.Visible = _G.EspDistance; if _G.EspDistance then 
                    local d = math.floor((LP.Character.HumanoidRootPart.Position - root.Position).Magnitude)
                    Dist.Text = "["..d.."m]"; Dist.Position = Vector2.new(pos.X, y + height + 2)
                end
                HBg.Visible = _G.EspHealth; HFg.Visible = _G.EspHealth; if _G.EspHealth then
                    local hp = hum.Health/hum.MaxHealth; local hH = math.clamp(12000/pos.Z, 20, 42)
                    HBg.Size = Vector2.new(3, hH); HBg.Position = Vector2.new(x - 6, pos.Y - hH/2)
                    HFg.Size = Vector2.new(3, hH * hp); HFg.Position = Vector2.new(x - 6, (pos.Y - hH/2) + hH * (1 - hp)); HFg.Color = Color3.fromRGB(255*(1-hp), 255*hp, 60)
                end
                return
            end
        end
        Box.Visible = false; Name.Visible = false; Dist.Visible = false; HBg.Visible = false; HFg.Visible = false
        if not p.Parent then Box:Remove(); Name:Remove(); Dist:Remove(); HBg:Remove(); HFg:Remove() end
    end)
end

for _, p in pairs(Players:GetPlayers()) do CreateESP(p) end
